# Yoga Companie — environment variables (BOUWPROMPT §22)
# Kopieer dit bestand naar .env.local en vul de waarden in.
# Zet NOOIT echte sleutels in git.

# --- Supabase (regio Frankfurt, eu-central-1) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                     # alleen voor CI en migrations

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Yoga Companie <info@yogacompanie.nl>"

# --- AI (socialmediatool) ---
ANTHROPIC_API_KEY=

# --- Meta (Facebook / Instagram), achter feature flag ---
META_PUBLISHING_ENABLED=false
META_APP_ID=
META_APP_SECRET=

# --- Algemeen ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEED_ADMIN_EMAIL=
