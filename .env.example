# YogaCompany — omgevingsvariabelen
# Kopieer dit bestand naar .env.local en vul de waarden in.
# Zet NOOIT echte sleutels in git.

# --- Supabase (EU-regio; zie docs/supabase-project.md) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=                     # alleen voor CI en migrations

# --- Betalingen (Mollie) ---
# Eén sleutel is genoeg om online betalen aan te zetten. Test- of live-modus
# volgt uit het voorvoegsel: test_… of live_…. Zie docs/payments.md.
# Zolang deze leeg is, wordt een inschrijving een aanvraag en neem je zelf
# contact op met de klant — de site blijft dus gewoon werken.
MOLLIE_API_KEY=
# Optioneel. Zet op false om betalen dicht te houden terwijl de sleutel er wel
# staat. Alles behalve "false" laat betalen aan.
PAYMENTS_ENABLED=

# --- E-mail (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="YogaCompany <info@yogacompanie.nl>"

# --- AI (socialmediatool) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=                     # optioneel; standaard claude-sonnet-5

# --- Meta (Facebook / Instagram), achter feature flag ---
META_PUBLISHING_ENABLED=false
META_APP_ID=
META_APP_SECRET=
META_PAGE_ID=                        # Facebook-pagina
META_INSTAGRAM_ACCOUNT_ID=           # Instagram Business-account
META_ACCESS_TOKEN=                   # long-lived page token

# --- Mailings ---
# Ondertekent de afmeldlink in elke mailing. Zonder deze waarde worden er geen
# mailings verstuurd. Genereer met: openssl rand -base64 32
MAILING_UNSUBSCRIBE_SECRET=

# --- Geplande taken ---
# Beschermt /api/v1/cron/*. De cron stuurt hem mee als Bearer-token.
CRON_SECRET=

# --- Algemeen ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SEED_ADMIN_EMAIL=
