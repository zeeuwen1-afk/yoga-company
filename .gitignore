# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# playwright
/playwright-report/
/test-results/
/blob-report/
/.playwright/

# supabase (lokale ontwikkeling)
/supabase/.branches
/supabase/.temp

# env files — .env.example wordt bewust wel meegecommit
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Kopieën die iCloud maakt bij een synchronisatieconflict. Dit project staat in
# ~/Documents, en die map wordt door iCloud gesynchroniseerd. Bij een conflict
# blijft er een "bestand 2.ts" achter. Die draaien gewoon mee: een dubbele
# testspec telt dubbel, een dubbele migration draait twee keer. Ze horen hier
# niet, dus git ziet ze niet meer.
* [0-9].*
* ([0-9]).*
